{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DockBox",
  "version": "0.1.0",
  "identifier": "com.dockbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "DockBox",
    "shortDescription": "轻量级 Docker Web 工具面板",
    "longDescription": "DockBox - 轻量级 Docker Web 工具面板：左侧标签、右侧页面、托盘驻留、WebDAV 同步。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
